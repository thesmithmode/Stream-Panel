{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "allowJs": true,
    "checkJs": true,
    "types": [
      "svelte",
      "vite/client"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}

#!/usr/bin/env bash
set -euo pipefail
app_root="${STREAM_PANEL_INSTALL_ROOT:-/opt/stream-panel-local}"
lock_dir="${XDG_RUNTIME_DIR:-$HOME/.cache}"
if [[ $# -gt 0 ]]; then echo 'Использование: stream-panel' >&2; exit 1; fi
mkdir -p "$lock_dir"
exec 9>"$lock_dir/stream-panel-local.lock"
if ! flock -n 9; then
  xdg-open "http://127.0.0.1:${STREAM_PANEL_PORT:-47831}" >/dev/null 2>&1 || true
  exit 0
fi
cd "$app_root"
exec "$app_root/bin/node" dist/apps/daemon/src/local.js

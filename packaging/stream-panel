#!/usr/bin/env bash
set -euo pipefail
app_root="${STREAM_PANEL_INSTALL_ROOT:-/opt/stream-panel-local}"
local_dir="${STREAM_PANEL_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/stream-panel-local}"
lock_dir="${XDG_RUNTIME_DIR:-$HOME/.cache}"
mkdir -p "$lock_dir"
exec 9>"$lock_dir/stream-panel-local.lock"
if ! flock -n 9; then
  xdg-open "http://127.0.0.1:${STREAM_PANEL_PORT:-47831}" >/dev/null 2>&1 || true
  exit 0
fi
if [[ ! -f "$local_dir/local-ready" ]]; then
  if [[ -z "${STREAM_PANEL_INITIAL_PASSWORD:-}" ]]; then
    echo 'Локальный вход: ruslan. Задайте пароль панели (минимум 14 символов).'
    read -r -s -p 'Пароль: ' stream_panel_password
    echo
    export STREAM_PANEL_INITIAL_PASSWORD="$stream_panel_password"
  fi
fi
cd "$app_root"
exec "$app_root/bin/node" dist/apps/daemon/src/local.js

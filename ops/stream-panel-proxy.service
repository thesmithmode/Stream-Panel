[Unit]
Description=Stream Panel isolated HTTPS proxy
After=network-online.target
Wants=network-online.target
[Service]
User=stream-panel-proxy
Group=stream-panel-proxy
ExecStart=/opt/stream-panel/proxy/caddy run --config /etc/stream-panel/Caddyfile --adapter caddyfile
Environment=XDG_DATA_HOME=/var/lib/stream-panel-proxy
Environment=XDG_CONFIG_HOME=/var/lib/stream-panel-proxy
Restart=on-failure
RestartSec=5
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/stream-panel-proxy
MemoryMax=128M
CPUQuota=20%
[Install]
WantedBy=multi-user.target

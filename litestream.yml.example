# Example Litestream config for Stream Panel → Cloudflare R2 (or Backblaze B2).
# Copy to your data directory (never commit real keys). Secrets come from env.
#
#   export LITESTREAM_ACCESS_KEY_ID=...
#   export LITESTREAM_SECRET_ACCESS_KEY=...
#   export STREAM_PANEL_DB_PATH="$HOME/.local/share/stream-panel/data.sqlite"
#   ./scripts/litestream-replicate.sh
#
# Docs: docs/ops/litestream.md

dbs:
  - path: ${STREAM_PANEL_DB_PATH}
    replicas:
      - type: s3
        bucket: stream-panel-backups
        path: stream-panel
        endpoint: https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
        region: auto
        # Litestream reads AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY by default.
        # For R2, create an API token with Object Read & Write.
